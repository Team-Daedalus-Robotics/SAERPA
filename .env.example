# Copy this file to .env and update the values.
# cp .env.example .env

# PostgreSQL credentials used by the AppHost.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# The available PostGIS image is amd64; Apple Silicon uses emulation.
POSTGRES_PLATFORM=linux/amd64

# Laya API configuration. Set API_KEY to a valid credential for the API.
API_KEY=local
BASE_URL=http://localhost:11435
DECIDE_URL=http://localhost:11435/api/decide
MODEL=laya:multilingual
QUERY_LIMIT=100

# Optional legacy aliases used when the primary variables are unset.
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=http://localhost:11435
# TYPESAFE_DEFAULT_MODEL=laya:multilingual

# DATABASE_URL is injected by Aspire from the PostgreSQL resource.
