# Copie este arquivo para .env e ajuste os valores
# cp .env.example .env

# Credenciais do Postgres (usadas pelo AppHost)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua-senha-aqui
# A imagem oficial PostGIS disponível no projeto é amd64; Apple Silicon usa emulação.
POSTGRES_PLATFORM=linux/amd64

# Portas fixas
# Postgres: 5432 (definida em apphost.mts)
# Web: 4200 (definida em apphost.mts)
