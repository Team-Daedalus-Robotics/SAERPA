# Copy this file to .env and update the values.
# cp .env.example .env

# PostgreSQL credentials used by the AppHost.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Container target platform for postgis/postgis:18-3.6 (amd64 only).
# Apple Silicon (arm64) runs this image through Docker Desktop emulation.
# Intel Macs and x86_64 Linux/Windows hosts also use linux/amd64.
# Set linux/arm64 only after switching to a PostGIS image that supports arm64.
POSTGRES_PLATFORM=linux/amd64

# Laya API configuration. Set API_KEY to a valid credential for the API.
API_KEY=local
BASE_URL=http://localhost:11435
DECIDE_URL=http://localhost:11435/api/decide
MODEL=laya:multilingual
QUERY_LIMIT=100

# NASA Earthdata Login credentials (required only for the SMAP/AppEEARS flow).
# Create a free account at https://urs.earthdata.nasa.gov/
EARTHDATA_USER=
EARTHDATA_PASS=

# Satellite data worker (nasa_event_worker).
# Watched locations come from the `property` table (lat, lng).
# Seconds between worker cycles.
NASA_EVENT_POLL_SECONDS=900
# Days of history fetched on the first visit of a location (POWER in one request, SMAP in weekly tasks from the most recent backwards).
NASA_EVENT_BACKFILL_DAYS=365
EARTHDATA_USER=
EARTHDATA_PASS=

# Optional legacy aliases used when the primary variables are unset.
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=http://localhost:11435
# TYPESAFE_DEFAULT_MODEL=laya:multilingual

# DATABASE_URL is injected by Aspire from the PostgreSQL resource.
